# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (at any depth, so no workspace's own node_modules is tracked)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/.next-e2e/
/.next-cli-e2e/
/out/

# production
/build
# the CLI workspace's bundle, rebuilt by its `prepare` script on npm install
/cli/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite database
/data/*
!/data/.gitkeep

# Claude Code worktrees
/.claude/worktrees/
